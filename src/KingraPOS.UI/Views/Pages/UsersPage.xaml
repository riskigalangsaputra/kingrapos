<UserControl x:Class="KingraPOS.UI.Views.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pengguna" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,16" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="180" />
                <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="120" />
                <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <ui:Card Grid.Row="2" Padding="20" Margin="0,12,0,0" IsEnabled="{Binding CanManageUsers}">
            <StackPanel>
                <TextBlock Text="Tambah Pengguna" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Username" Margin="12,0,0,0" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Password" Margin="12,0,0,0" />

                    <ui:TextBox Grid.Row="1" Grid.Column="0"
                                Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,4,12,12" />
                    <ui:TextBox Grid.Row="1" Grid.Column="1"
                                Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,4,12,12" />
                    <ui:TextBox Grid.Row="1" Grid.Column="2"
                                Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,4,0,12" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Kode karyawan (opsional)" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Role" Margin="12,0,0,0" />
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                Text="{Binding NewEmployeeCode}"
                                Margin="0,0,12,0" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}"
                              DisplayMemberPath="Name"
                              Margin="0,0,12,0" />

                    <ui:Button Grid.Column="2"
                               Content="Tambah"
                               Appearance="Primary"
                               Command="{Binding CreateCommand}"
                               Margin="0,0,12,0" />

                    <ui:Button Grid.Column="3"
                               Content="Aktif / Nonaktif"
                               Command="{Binding ToggleActiveCommand}" />
                </Grid>

                <TextBlock Text="{Binding Message}"
                           Foreground="#FF7B7B"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
