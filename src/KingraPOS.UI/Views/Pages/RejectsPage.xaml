<UserControl x:Class="KingraPOS.UI.Views.Pages.RejectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Barang Rusak" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,12" IsEnabled="{Binding CanReject}">
                <StackPanel>
                    <TextBlock Text="Catat Barang Rusak" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Produk" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Jumlah (satuan dasar, x1000)" Margin="12,0,0,0" />

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  DisplayMemberPath="ProductName"
                                  Margin="0,4,12,12" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1"
                                    Text="{Binding Quantity}"
                                    Margin="0,4,0,12" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Alasan" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Supplier (opsional)" Margin="12,0,0,0" />

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding Reasons}"
                                  SelectedItem="{Binding RejectReason}"
                                  IsEditable="True"
                                  Text="{Binding RejectReason}"
                                  Margin="0,4,12,12" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  DisplayMemberPath="Name"
                                  Margin="0,4,0,12" />
                    </Grid>

                    <TextBlock Text="Catatan" />
                    <ui:TextBox Text="{Binding Notes}" Margin="0,4,0,12" />

                    <ui:Button Content="Catat Barang Rusak" Appearance="Primary"
                               HorizontalAlignment="Left"
                               Command="{Binding RecordCommand}" />

                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               Foreground="#E0A030"
                               Margin="0,12,0,0" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Daftar Barang Rusak" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" Content="Hanya belum selesai" IsChecked="{Binding OpenOnly}" Margin="0,0,12,0" />
                        <ui:Button Grid.Column="2" Content="Muat Ulang" Command="{Binding ReloadCommand}" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <ui:Button Content="Kembalikan ke Supplier"
                                       Command="{Binding ResolveCommand}"
                                       CommandParameter="RETURNED"
                                       IsEnabled="{Binding CanReject}"
                                       Margin="0,0,12,0" />
                            <ui:Button Content="Hapus (Kerugian)"
                                       Appearance="Danger"
                                       Command="{Binding ResolveCommand}"
                                       CommandParameter="WRITTEN_OFF"
                                       IsEnabled="{Binding CanReject}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid ItemsSource="{Binding Logs}"
                              SelectedItem="{Binding SelectedLog}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt, StringFormat='dd MMM yyyy HH:mm'}" Width="150" />
                            <DataGridTextColumn Header="Produk" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Alasan" Binding="{Binding RejectReason}" Width="110" />
                            <DataGridTextColumn Header="Jumlah" Binding="{Binding Quantity}" Width="90" />
                            <DataGridTextColumn Header="HPP" Binding="{Binding CostPriceAtIncident, StringFormat='Rp {0:N0}'}" Width="110" />
                            <DataGridTextColumn Header="Kerugian" Binding="{Binding TotalLossAmount, StringFormat='Rp {0:N0}'}" Width="120" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
