<UserControl x:Class="KingraPOS.UI.Views.Pages.BackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Backup &amp; Restore" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Ringkasan" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Text="Backup berhasil terakhir" Opacity="0.7" />
                    <TextBlock Text="{Binding LastBackupText}" FontWeight="SemiBold" Margin="0,4,0,8" />

                    <TextBlock Text="{Binding HealthWarning}"
                               Foreground="#E0A030"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <ui:Button Content="Backup Sekarang"
                               Appearance="Primary"
                               HorizontalAlignment="Left"
                               Padding="20,10"
                               IsEnabled="{Binding CanBackup}"
                               Command="{Binding BackupNowCommand}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,12" IsEnabled="{Binding CanBackup}">
                <StackPanel>
                    <TextBlock Text="Jadwal Backup Otomatis" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <CheckBox Content="Aktifkan backup terjadwal" IsChecked="{Binding IsScheduleActive}" Margin="0,0,0,12" />

                    <TextBlock Text="Frekuensi" />
                    <ComboBox ItemsSource="{Binding Frequencies}"
                              SelectedItem="{Binding Frequency}"
                              Margin="0,4,0,12" />

                    <TextBlock Text="Jam jalan (HH:MM, waktu lokal usaha)" />
                    <ui:TextBox Text="{Binding RunTime}" Margin="0,4,0,12" />

                    <StackPanel Visibility="{Binding ShowDayOfWeek, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Hari (untuk jadwal mingguan)" />
                        <ComboBox ItemsSource="{Binding Days}"
                                  SelectedItem="{Binding SelectedDay}"
                                  DisplayMemberPath="Name"
                                  Margin="0,4,0,12" />
                    </StackPanel>

                    <TextBlock Text="Jumlah salinan disimpan" />
                    <ui:TextBox Text="{Binding RetentionCount}" Margin="0,4,0,12" />

                    <TextBlock Text="Folder tujuan" />
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding DestinationPath}"
                                    Margin="0,0,12,0" />

                        <ui:Button Grid.Column="1"
                                   Content="Pilih Folder"
                                   Command="{Binding BrowseDestinationCommand}" />
                    </Grid>

                    <ui:Button Content="Simpan Jadwal"
                               Appearance="Primary"
                               HorizontalAlignment="Left"
                               Padding="20,10"
                               Command="{Binding SaveScheduleCommand}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Riwayat Backup" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <DataGrid ItemsSource="{Binding History}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Waktu" Binding="{Binding StartedAt, StringFormat='dd MMM yyyy HH:mm'}" Width="150" />
                            <DataGridTextColumn Header="Pemicu" Binding="{Binding TriggerType}" Width="100" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="Ukuran" Binding="{Binding FileSizeBytes}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" IsEnabled="{Binding CanRestore}">
                <StackPanel>
                    <TextBlock Text="Restore" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Text="Seluruh data saat ini akan digantikan oleh file backup. Backup darurat dibuat otomatis sebelum proses berjalan."
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding SelectedBackupFile}"
                                    IsReadOnly="True"
                                    Margin="0,0,12,0" />

                        <ui:Button Grid.Column="1"
                                   Content="Pilih File"
                                   Command="{Binding BrowseBackupFileCommand}"
                                   Margin="0,0,12,0" />

                        <ui:Button Grid.Column="2"
                                   Content="Restore"
                                   Appearance="Danger"
                                   Command="{Binding RestoreCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               Foreground="#8ED08E"
                               Margin="0,4,0,0" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
