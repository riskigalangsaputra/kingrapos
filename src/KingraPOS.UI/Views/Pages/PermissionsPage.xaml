<UserControl x:Class="KingraPOS.UI.Views.Pages.PermissionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Hak Akses" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,12" IsEnabled="{Binding CanManage}">
                <StackPanel>
                    <TextBlock Text="Izin per Role" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Text="Role" />
                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}"
                              DisplayMemberPath="Name"
                              Margin="0,4,0,12" />

                    <DataGrid ItemsSource="{Binding RolePermissions}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Modul" Binding="{Binding Module}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Izin" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Kunci" Binding="{Binding Key}" Width="180" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Aktif" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding RoleMessage}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="#E0A030" />

                        <ui:Button Grid.Column="1"
                                   Content="Simpan Izin Role"
                                   Appearance="Primary"
                                   Padding="20,10"
                                   Command="{Binding SaveRolePermissionsCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" IsEnabled="{Binding CanManage}">
                <StackPanel>
                    <TextBlock Text="Pengecualian per Pengguna" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Text="Izin efektif = izin role, ditambah 'Izinkan', dikurangi 'Cabut'. Pilihan 'Ikut role' menghapus pengecualian."
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Pengguna" />
                    <ComboBox ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              DisplayMemberPath="Name"
                              Margin="0,4,0,12" />

                    <DataGrid ItemsSource="{Binding UserPermissions}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Modul" Binding="{Binding Module}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Izin" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="Efektif" Binding="{Binding IsEffective}" Width="80" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Pengecualian" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.OverrideOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding State, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding UserMessage}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="#E0A030" />

                        <ui:Button Grid.Column="1"
                                   Content="Simpan Pengecualian"
                                   Appearance="Primary"
                                   Padding="20,10"
                                   Command="{Binding SaveUserOverridesCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
