<UserControl x:Class="KingraPOS.UI.Views.Pages.SuppliersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Supplier" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,16" />

            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      MaxHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Telepon" Binding="{Binding PhoneNumber}" Width="150" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" />
                    <DataGridTextColumn Header="Kontak" Binding="{Binding ContactCount}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <ui:Card Padding="20" Margin="0,12,0,0" IsEnabled="{Binding CanManage}">
                <StackPanel>
                    <TextBlock Text="Tambah / Ubah Supplier" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama supplier *" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Nomor telepon *" Margin="12,0,0,0" />

                        <ui:TextBox Grid.Row="1" Grid.Column="0"
                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,4,12,12" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1"
                                    Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,4,0,12" />
                    </Grid>

                    <TextBlock Text="Email" />
                    <ui:TextBox Text="{Binding Email}" Margin="0,4,0,12" />

                    <TextBlock Text="Alamat" />
                    <ui:TextBox Text="{Binding Address}" AcceptsReturn="True" TextWrapping="Wrap" Height="50" Margin="0,4,0,12" />

                    <TextBlock Text="Catatan" />
                    <ui:TextBox Text="{Binding Notes}" Margin="0,4,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Baru" Command="{Binding NewCommand}" Margin="0,0,12,0" />
                        <ui:Button Content="Simpan" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,12,0" />
                        <ui:Button Content="Hapus" Appearance="Danger" Command="{Binding DeleteCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               Foreground="#E0A030"
                               Margin="0,12,0,0" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,12,0,0" IsEnabled="{Binding CanManage}">
                <StackPanel>
                    <TextBlock Text="Kontak Sales" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <DataGrid ItemsSource="{Binding Contacts}"
                              SelectedItem="{Binding SelectedContact}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Telepon" Binding="{Binding PhoneNumber}" Width="150" />
                            <DataGridTextColumn Header="Jabatan" Binding="{Binding Position}" Width="150" />
                            <DataGridCheckBoxColumn Header="Utama" Binding="{Binding IsPrimary}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama kontak *" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Telepon" Margin="12,0,0,0" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Jabatan" Margin="12,0,0,0" />

                        <ui:TextBox Grid.Row="1" Grid.Column="0"
                                    Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,4,12,0" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1"
                                    Text="{Binding ContactPhoneNumber}"
                                    Margin="0,4,12,0" />
                        <ui:TextBox Grid.Row="1" Grid.Column="2"
                                    Text="{Binding ContactPosition}"
                                    Margin="0,4,0,0" />
                    </Grid>

                    <CheckBox Content="Jadikan kontak utama" IsChecked="{Binding ContactIsPrimary}" Margin="0,12,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Content="Kontak Baru" Command="{Binding NewContactCommand}" Margin="0,0,12,0" />
                        <ui:Button Content="Simpan Kontak" Appearance="Primary" Command="{Binding AddContactCommand}" Margin="0,0,12,0" />
                        <ui:Button Content="Hapus Kontak" Appearance="Danger" Command="{Binding RemoveContactCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ContactMessage}"
                               TextWrapping="Wrap"
                               Foreground="#E0A030"
                               Margin="0,12,0,0" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
