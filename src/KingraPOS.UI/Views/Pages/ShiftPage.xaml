<UserControl x:Class="KingraPOS.UI.Views.Pages.ShiftPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Shift Kasir" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Shift Berjalan" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Text="Tidak ada shift terbuka." Opacity="0.7"
                               Visibility="{Binding HasNoOpenShift, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Visibility="{Binding HasOpenShift, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CurrentShift.UserName, StringFormat='Kasir: {0}'}" />
                        <TextBlock Text="{Binding CurrentShift.StartTime, StringFormat='Mulai: {0:dd MMM yyyy HH:mm}'}" Opacity="0.7" />
                        <TextBlock Text="{Binding CurrentShift.CashDrawerStart, StringFormat='Modal awal: Rp {0:N0}'}" />
                        <TextBlock Text="{Binding CurrentShift.CashSalesAmount, StringFormat='Penjualan tunai: Rp {0:N0}'}" />
                        <TextBlock Text="{Binding ExpectedCash, StringFormat='Kas sistem seharusnya: Rp {0:N0}'}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,12"
                     IsEnabled="{Binding CanOpen}"
                     Visibility="{Binding HasNoOpenShift, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Buka Shift" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Modal awal (uang kembalian)" />
                    <ui:TextBox Text="{Binding CashDrawerStart}" Margin="0,4,0,12" />
                    <TextBlock Text="Catatan (opsional)" />
                    <ui:TextBox Text="{Binding Notes}" Margin="0,4,0,12" />
                    <ui:Button Content="Buka Shift" Appearance="Primary" Command="{Binding OpenCommand}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,12"
                     IsEnabled="{Binding CanClose}"
                     Visibility="{Binding HasOpenShift, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Tutup Shift" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Uang fisik di laci" />
                    <ui:TextBox Text="{Binding PhysicalCash}" Margin="0,4,0,12" />
                    <TextBlock Text="Catatan (opsional)" />
                    <ui:TextBox Text="{Binding Notes}" Margin="0,4,0,12" />
                    <ui:Button Content="Tutup Shift" Appearance="Primary" Command="{Binding CloseCommand}" Margin="0,0,0,16" />

                    <TextBlock Text="Ganti Shift" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"
                               Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Modal awal shift baru" />
                        <ui:TextBox Text="{Binding SwitchNewCashDrawerStart}" Margin="0,4,0,12" />
                        <TextBlock Text="PIN (bila diatur)" />
                        <PasswordBox x:Name="PinInput" PasswordChanged="OnPinChanged" Margin="0,4,0,12" />
                        <ui:Button Content="Ganti Shift" Command="{Binding SwitchCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,12" Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Riwayat Shift" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding Shifts}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mulai" Binding="{Binding StartTime, StringFormat='dd MMM yyyy HH:mm'}" Width="150" />
                            <DataGridTextColumn Header="Selesai" Binding="{Binding EndTime, StringFormat='dd MMM yyyy HH:mm'}" Width="150" />
                            <DataGridTextColumn Header="Kasir" Binding="{Binding UserName}" Width="*" />
                            <DataGridTextColumn Header="Modal" Binding="{Binding CashDrawerStart, StringFormat='{}{0:N0}'}" Width="100" />
                            <DataGridTextColumn Header="Kas Sistem" Binding="{Binding CashDrawerEndSystem, StringFormat='{}{0:N0}'}" Width="110" />
                            <DataGridTextColumn Header="Kas Fisik" Binding="{Binding CashDrawerEndPhysical, StringFormat='{}{0:N0}'}" Width="110" />
                            <DataGridTextColumn Header="Selisih" Binding="{Binding DiscrepancyAmount, StringFormat='{}{0:N0}'}" Width="100" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <ui:Button Content="Muat Ulang" Command="{Binding ReloadCommand}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#E0A030" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
