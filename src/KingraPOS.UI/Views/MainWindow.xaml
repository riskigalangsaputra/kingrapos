<ui:FluentWindow x:Class="KingraPOS.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Kingra POS"
        Width="1100" Height="720"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Kingra POS" />

        <ScrollViewer Grid.Row="1" Padding="28,12,28,28" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dashboard"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="0,4,0,18" />

                <UniformGrid Columns="3" Rows="1">
                    <ui:Card Margin="0,0,12,0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Penjualan Hari Ini" Opacity="0.7" />
                            <TextBlock Text="{Binding TodayRevenue, StringFormat='Rp {0:N0}'}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="6,0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Transaksi" Opacity="0.7" />
                            <TextBlock Text="{Binding TodayTransactions}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="12,0,0,0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Produk" Opacity="0.7" />
                            <TextBlock Text="{Binding Products.Count}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </ui:Card>
                </UniformGrid>

                <ui:Card Margin="0,20,0,0" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Daftar Produk"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0"
                                        PlaceholderText="Cari produk berdasarkan nama atau SKU..."
                                        Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,12,0" />

                            <ui:Button Grid.Column="1"
                                       Appearance="Primary"
                                       Content="Cari"
                                       Command="{Binding SearchCommand}"
                                       Margin="0,0,12,0" />

                            <ui:Button Grid.Column="2"
                                       Content="Jual 1"
                                       Command="{Binding SellCommand}" />
                        </Grid>

                        <DataGrid ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130" />
                                <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Harga" Binding="{Binding Price, StringFormat='Rp {0:N0}'}" Width="150" />
                                <DataGridTextColumn Header="Stok" Binding="{Binding Stock}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="28,0,28,16"
                   Opacity="0.7" />
    </Grid>
</ui:FluentWindow>
