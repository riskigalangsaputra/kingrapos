<ui:FluentWindow x:Class="KingraPOS.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Kingra POS"
        Width="900" Height="560"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Kingra POS" />

        <StackPanel Grid.Row="1" Margin="28,12,28,28">
            <TextBlock Text="KingraPOS"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,4,0,8" />

            <TextBlock Text="Struktur project dan layer database sudah siap. UI serta business logic belum diimplementasikan."
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />

            <ui:Card Padding="20">
                <StackPanel>
                    <TextBlock Text="Database SQLite"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding DatabasePath}"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
